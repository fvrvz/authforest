# Backend environment variables
# Copy this file to .env and adjust values

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=authforest
DB_SSLMODE=disable
JWT_SECRET="change-me"

# Optional Runtime CORS and Admin Panel Config:
# Comma-separated allowed CORS origins (default: http://localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated admin panel OAuth redirect URIs (default: http://localhost:5173/callback)
ADMIN_PANEL_REDIRECT_URIS=http://localhost:5173/callback
# Or simply set your frontend URL (automatically configures CORS origin and /callback redirect URI)
# ADMIN_PANEL_URL=https://authforest.byfaraaz.com
